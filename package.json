{
  "name": "adonisjs-kysely",
  "description": "A kysely package to help adonisjs project",
  "version": "0.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "src",
    "types",
    "build/commands",
    "build/providers",
    "build/services",
    "build/src",
    "build/stubs",
    "build/index.js",
    "build/index.d.ts",
    "build/configure.js",
    "build/configure.d.ts"
  ],
  "exports": {
    ".": "./build/index.js",
    "./services/main": "./build/services/kysely.js",
    "./services/db_context": "./build/services/db_context.js",
    "./services/execution_context": "./build/services/execution_context.js",
    "./services/seeder": "./build/services/seeder.js",
    "./services/test_utils": "./build/services/test_utils.js",
    "./commands": "./build/commands/main.js",
    "./commands/*": "./build/commands/*.js",
    "./types": "./build/src/types.js",
    "./kysely_provider": "./build/providers/kysely_provider.js",
    "./types/db": {
      "types": "./types/db.d.ts",
      "default": "./types/db.d.ts"
    }
  },
  "scripts": {
    "index:commands": "adonis-kit index build/commands",
    "build": "npm run lint && npm run clean && npm run build-only && npm run copyfiles && npm run index:commands",
    "dev": "npm unlink && npm run build && npm link",
    "build-only": "tsc",
    "clean": "del-cli build",
    "copyfiles": "copyfiles \"stubs/**/**/*.stub\" build",
    "build-dev": "npm run build && npm pack",
    "format": "prettier --write .",
    "lint": "eslint .",
    "release": "npx release-it",
    "prepublishOnly": "npm run build"
  },
  "imports": {
    "#src/*": "./src/*.js",
    "#services/*": "./services/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.0",
    "@adonisjs/core": "^7.5.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@swc/core": "1.16.1",
    "@types/node": "^26.3.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "eslint": "^10.9.1",
    "hot-hook": "^1.0.0",
    "kysely": "^0.29.5",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "ts-node-maintained": "^10.9.6",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@poppinss/utils": "^7.0.1"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "kysely": "^0.29.0"
  },
  "author": "Kalvin VILLA <kalvin.villa@pm.me>",
  "license": "MIT",
  "keywords": [
    "kysely",
    "database"
  ],
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config"
}
